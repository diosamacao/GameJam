  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa0be747ec7cf4b4798737b2a1dc4e98, type: 3}
  m_Name: "25_怀念与梦境"
  m_EditorClassIdentifier: ""
  blockPlayerInput: 1
  typewriter: 1
  charactersPerSecond: 30
  lines:
  - speaker: "伊"
    text: "尼？！"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "哇！！"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "突然怎么了，吓我一跳。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "而且，你这是..."
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "我好像做了一个梦？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "梦里，我对你说了一些话......"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "你现在出现了怀念的情感诶。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "那些是回忆？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "也许是模拟空间出现了一些异常？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "（......）"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "先收集情感碎片，离开模拟空间吧。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "（我对尼说过那些话吗......）"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "（那真的是我吗？）"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  stagingNotes: "原稿第25段：怀念与梦境。句尾c为手动翻页标记，已移除；未标c的同角色连续行保留换行。尚未绑定场景触发、情感解锁或演出事件。"
