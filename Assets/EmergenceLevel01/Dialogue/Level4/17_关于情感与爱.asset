  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa0be747ec7cf4b4798737b2a1dc4e98, type: 3}
  m_Name: "17_关于情感与爱"
  m_EditorClassIdentifier: ""
  blockPlayerInput: 1
  typewriter: 1
  charactersPerSecond: 30
  lines:
  - speaker: "伊"
    text: "尼，之前实验的时候我只是读取了情感数据。\n现在我能感受到它们了。\n但是我要怎么才能自发的产生情感呢？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "你想要成为人类吗？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "成为人类？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "开个玩笑啦，\n人类会出现情感，是因为他们感受着这个世界，爱着这个世界\n你有想做的事吗？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "爱？想做的事？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "不要紧，你会慢慢明白的。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  stagingNotes: "原稿第17段：关于情感与爱。句尾c为手动翻页标记，已移除；未标c的同角色连续行保留换行。尚未绑定场景触发、情感解锁或演出事件。"
