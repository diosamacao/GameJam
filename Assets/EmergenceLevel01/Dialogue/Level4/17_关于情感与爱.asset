  lines:
  - speaker: "\u4F0A"
    text: "\u5C3C\uFF0C\u4E4B\u524D\u5B9E\u9A8C\u7684\u65F6\u5019\u6211\u53EA\u662F\u8BFB\u53D6\u4E86\u60C5\u611F\u6570\u636E\u3002\u73B0\u5728\u6211\u80FD\u611F\u53D7\u5230\u5B83\u4EEC\u4E86\u3002"
