  m_Script: {fileID: 11500000, guid: fa0be747ec7cf4b4798737b2a1dc4e98, type: 3}
  m_Name: "19_人格信号的疑问"
  m_EditorClassIdentifier: ""
  blockPlayerInput: 1
  typewriter: 1
  charactersPerSecond: 30
  lines:
  - speaker: "尼"
    text: "哇！你真厉害！"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "尼，博士说你在这里接收着一个人格信号"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "对啊，所以我现在算是半个人类吧？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "可我记得，你在进入实验舱之前，就已经表现得像个人类了吧？\n从休眠仓出来后，你就向我打了招呼。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "是......是吗？\n可能是...在唤醒我之前，模拟人格数据就传输到我身上了..."
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  stagingNotes: "原稿第19段：人格信号的疑问。句尾c为手动翻页标记，已移除；未标c的同角色连续行保留换行。尚未绑定场景触发、情感解锁或演出事件。"
