  - speaker: "\u535A\u58EB"
    text: "\u5662\uFF01\u4F60\u597D\uFF01\u4F60\u662F\u7B2C\u4E00\u4E2A\u642D\u8F7D\u4E86\u60C5\u611F\u6570\u636E\u6838\u5FC3\u7684\u673A\u68B0\uFF0C\u5C31\u53EB\u4F60\u4F0A\u5427\uFF01"
    minimumDisplaySeconds: 0
    cue: doctor_face_player
  - speaker: "\u4F0A"
    text: "\u4F0A\u2026\u2026\u8FD9\u662F\u6211\u7684\u4EE3\u53F7\u5417\uFF1F"
    minimumDisplaySeconds: 1
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5BF9\uFF01\u4F60\u5C31\u662F\u673A\u68B0\u4F53\uFF0C\u4EE3\u53F7\uFF1A\u4F0A\u3002"
    minimumDisplaySeconds: 0
    cue: 
  stagingNotes: "\u9996\u53E5\u4E0D\u663E\u793A\u59D3\u540D\u3002\u535A\u58EB\u53D8idle\u5E76\u8F6C\u8EAB\u9762\u5BF9\u73A9\u5BB6\u3002\u7ED3\u675F\u540E\u53F32\u84DD\u8272\u8231\u95E8\u6253\u5F00\uFF0C\u914D\u89D2\u8D70\u51FA\uFF0C\u518D\u89E6\u53D103_ExperimentBriefing\u3002"
