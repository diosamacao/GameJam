  lines:
  - speaker: 
    text: "\u65E9\u4E0A\u597D\uFF0C\u535A\u58EB\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5662\uFF01\u4F60\u597D\uFF01\u4F60\u662F\u7B2C\u4E00\u4E2A\u642D\u8F7D\u4E86\u60C5\u611F\u6570\u636E\u6838\u5FC3\u7684\u673A\u68B0\uFF0C\u5C31\u53EB\u4F60\u4F0A\u5427\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: doctor_face_player
  - speaker: "\u4F0A"
    text: "\u4F0A\u2026\u2026<pause=0.5>\u8FD9\u662F\u6211\u7684\u4EE3\u53F7\u5417\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5BF9\uFF01\u4F60\u5C31\u662F\u673A\u68B0\u4F53\uFF0C\u4EE3\u53F7\uFF1A\u4F0A\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u7B2C\u4E8C\u4E2A\u673A\u68B0\u4E5F\u6210\u529F\u542F\u52A8\u4E86\uFF01\u592A\u597D\u4E86\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ni_walk_to_player
  - speaker: "\u535A\u58EB"
    text: "\u4F60\u7684\u4EE3\u53F7\u5C31\u53EB\u5C3C\u5427\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u5C3C"
    text: "\u597D\u7684\uFF0C\u535A\u58EB\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u73B0\u5728\u9700\u8981\u4F60\u4EEC\u8FDB\u5165\u90A3\u8FB9\u7684\u5B9E\u9A8C\u8231\u91CC\uFF0C\u8FDB\u884C\u60C5\u611F\u6A21\u62DF\u573A\u666F\u5B9E\u9A8C\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u586B\u5145\u4F60\u4EEC\u7684\u60C5\u611F\u6570\u636E\uFF0C\u8BA9\u4F60\u4EEC\u80FD\u81EA\u53D1\u7684\u6D8C\u73B0\u60C5\u611F\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5F53\u7136\uFF0C\u8FD9\u662F\u6700\u7406\u60F3\u7684\u60C5\u51B5\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5B9E\u9645\u4F1A\u53D8\u6210\u4EC0\u4E48\u6837\u6211\u4E5F\u4E0D\u77E5\u9053\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u53BB\u5427\uFF0C\u795D\u4F60\u4EEC\u6210\u529F\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u4F0A&\u5C3C"
    text: "\u660E\u767D\u4E86\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  stagingNotes: "\u9996\u53E5\u4E0D\u663E\u793A\u59D3\u540D\u3002\u535A\u58EB\u53D8idle\u5E76\u8F6C\u8EAB\u9762\u5BF9\u73A9\u5BB6\u3002\u7ED3\u675F\u540E\u53F32\u84DD\u8272\u8231\u95E8\u6253\u5F00\uFF0C\u914D\u89D2\u8D70\u51FA\uFF0C\u518D\u89E6\u53D103_ExperimentBriefing\u3002"
