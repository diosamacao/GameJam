  lines:
  - speaker: "\u4F0A"
    text: "\u535A\u58EB\uFF0C\u4F60\u600E\u4E48\u5728\u8FD9\u91CC\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u8FD9\u91CC\u662F\u6A21\u62DF\u7A7A\u95F4\uFF0C\u6211\u4E5F\u662F\u6A21\u62DF\u7684\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u54A6\uFF1F\u600E\u4E48\u4E0D\u89C1\u4EE3\u53F7\u5C3C\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u5C3C"
    text: "\u6211\u5728\u8FD9\u91CC\u54E6\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u5C3C"
    text: "\u6211\u4F3C\u4E4E\u662F\u8FDE\u63A5\u4E0A\u6A21\u62DF\u7CFB\u7EDF\u7684\u7EC8\u7AEF\u4E86\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u5BF9\u54E6\uFF01\u6211\u90FD\u5FD8\u4E86\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u6A21\u62DF\u7CFB\u7EDF\u9700\u8981\u4E00\u4E2A\u673A\u68B0\u63A5\u6536\u4E00\u4E2A\u6A21\u62DF\u4EBA\u683C\u4FE1\u53F7\uFF0C\u4F60\u73B0\u5728\u5E94\u8BE5\u62E5\u6709\u90A3\u4E2A\u4EBA\u683C\u4FE1\u53F7\u7684\u60C5\u611F\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u90A3\u5C31\u62DC\u6258\u4F60\u6559\u4ED6\u5B66\u4F1A\u60C5\u611F\u4E86\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u5C3C"
    text: "\u4EA4\u7ED9\u6211\u5427(\u2229_\u2229)"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u4F60\u5148\u8BD5\u7740\u611F\u53D7\u6211\u73B0\u5728\u5F00\u5FC3\u7684\u60C5\u611F\u5427\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  stagingNotes: "\u539F\u7A3F\u7B2C01\u6BB5\uFF1A\u6A21\u62DF\u7A7A\u95F4\u4E0E\u5F00\u5FC3\u6559\u5B66\u3002\u53E5\u5C3Ec\u4E3A\u624B\u52A8\u7FFB\u9875\u6807\u8BB0\uFF0C\u5DF2\u79FB\u9664\uFF1B\u672A\u6807c\u7684\u540C\u89D2\u8272\u8FDE\u7EED\u884C\u4FDD\u7559\u6362\u884C\u3002\u5C1A\u672A\u7ED1\u5B9A\u573A\u666F\u89E6\u53D1\u3001\u60C5\u611F\u89E3\u9501\u6216\u6F14\u51FA\u4E8B\u4EF6\u3002"
