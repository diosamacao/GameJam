%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa0be747ec7cf4b4798737b2a1dc4e98, type: 3}
  m_Name: "01_模拟空间与开心教学"
  m_EditorClassIdentifier: ""
  blockPlayerInput: 1
  typewriter: 1
  charactersPerSecond: 30
  lines:
  - speaker: "伊"
    text: "博士，你怎么在这里？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "这里是模拟空间，我也是模拟的。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "咦？怎么不见代号尼？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "我在这里哦！"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "我似乎是连接上模拟系统的终端了。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "对哦！我都忘了。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "模拟系统需要一个机械接收一个模拟人格信号，你现在应该拥有那个人格信号的情感。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "那就拜托你教他学会情感了！"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "交给我吧(∩_∩)"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "博士"
    text: "你先试着感受我现在开心的情感吧。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  stagingNotes: "原稿第01段：模拟空间与开心教学。句尾c为手动翻页标记，已移除；未标c的同角色连续行保留换行。尚未绑定场景触发、情感解锁或演出事件。"
