  m_Script: {fileID: 11500000, guid: fa0be747ec7cf4b4798737b2a1dc4e98, type: 3}
  m_Name: "27_属于自己的名字"
  m_EditorClassIdentifier: ""
  blockPlayerInput: 1
  typewriter: 1
  charactersPerSecond: 20
  autoPlay: 1
  autoAdvanceDelay: 2
  lines:
  - speaker: "尼"
    text: "对了，伊，你想要一个属于自己的名字吗？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "伊"
    text: "名字？我的名字不是伊吗？"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  - speaker: "尼"
    text: "那只是博士在唤醒你时，给你起的类似编号的东西。\n并不能代表真正的你。"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: ""
  stagingNotes: "原稿第27段：属于自己的名字。句尾c为手动翻页标记，已移除；未标c的同角色连续行保留换行。尚未绑定场景触发、情感解锁或演出事件。"
