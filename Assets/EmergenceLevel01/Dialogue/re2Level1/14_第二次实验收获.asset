  - speaker: "\u535A\u58EB"
    text: "\u600E\u4E48\u6837\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u6CA1\u6709\u51FA\u73B0\u6570\u636E\u9519\u8BEF\u4E4B\u7C7B\u7684\u5F02\u5E38\u5427\uFF1F"
    charactersPerSecond: 0
