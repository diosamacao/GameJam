  - speaker: "\u4F0A"
    text: "\u6CA1\u6709\u95EE\u9898\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u4F0A"
    text: "\u53EA\u662F\uFF0C\u6211\u611F\u53D7\u5230\u4E86\u4E00\u4E9B\u4E1C\u897F\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u5C3C"
    text: "\u662F\u611F\u53D7\u5230\u60C5\u611F\u4E86\u5417\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u4F0A"
    text: "\u8FD9\u662F\u4EBA\u7C7B\u7684\u60C5\u611F\u5417\uFF1F"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u54C8\u54C8\uFF01\u770B\u6765\u5B9E\u9A8C\u633A\u6210\u529F\u554A\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u518D\u591A\u8FDB\u884C\u51E0\u6B21\u5B9E\u9A8C\uFF0C\u5C31\u80FD\u8BA9\u4F60\u62E5\u6709\u5C5E\u4E8E\u81EA\u5DF1\u7684\u60C5\u611F\u4E86\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u6211\u5F97\u518D\u591A\u505A\u4E00\u4E9B\u60C5\u611F\u6838\u5FC3\uFF0C\u8BA9\u6240\u6709\u7684\u673A\u68B0\u90FD\u80FD\u6709\u81EA\u5DF1\u7684\u60C5\u611F\uFF01"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  - speaker: "\u535A\u58EB"
    text: "\u53BB\u4F11\u606F\u4E00\u4E0B\uFF0C\u51C6\u5907\u4E0B\u4E00\u6B21\u5B9E\u9A8C\u5427\u3002"
    charactersPerSecond: 0
    minimumDisplaySeconds: 0
    cue: 
  stagingNotes: "\u539F\u7A3F\u7B2C14\u6BB5\uFF1A\u7B2C\u4E8C\u6B21\u5B9E\u9A8C\u6536\u83B7\u3002\u53E5\u5C3Ec\u4E3A\u624B\u52A8\u7FFB\u9875\u6807\u8BB0\uFF0C\u5DF2\u79FB\u9664\uFF1B\u672A\u6807c\u7684\u540C\u89D2\u8272\u8FDE\u7EED\u884C\u4FDD\u7559\u6362\u884C\u3002\u5C1A\u672A\u7ED1\u5B9A\u573A\u666F\u89E6\u53D1\u3001\u60C5\u611F\u89E3\u9501\u6216\u6F14\u51FA\u4E8B\u4EF6\u3002"
